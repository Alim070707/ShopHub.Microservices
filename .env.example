# .env.example — скопируй в .env и заполни своими значениями
# ВАЖНО: файл .env НЕ коммитится в Git!

POSTGRES_PASSWORD=postgres_secret_password
RABBITMQ_PASSWORD=rabbitmq_secure_password

# SMTP (для NotificationService)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=app_password
SMTP_FROM=noreply@shophub.ru